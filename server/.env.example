# TonysCoin Digital Marketplace - Backend Environment Variables

# MongoDB Connection
MONGODB_URI=mongodb://localhost:27017/tonyscoin-marketplace

# Pinata IPFS Configuration (public file pinning)
PINATA_JWT=your_pinata_jwt_token_here
# Public gateway domain used to build file URLs (e.g. your-subdomain.pinata.cloud)
PINATA_GATEWAY=gateway.pinata.cloud

# Server Configuration
PORT=5000

# Optional: CORS origin for frontend
CORS_ORIGIN=http://localhost:3000
